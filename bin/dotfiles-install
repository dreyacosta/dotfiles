#!/bin/bash

set -u

readonly REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
  dotfiles-log "Usage: dotfiles-install <platform> [--dry-run] --links <source|target...>"
}

backup_name_for() {
  local target_path="$1"

  if [[ "$target_path" == "$HOME/"* ]]; then
    printf '%s\n' "${target_path#"$HOME/"}"
  else
    printf '%s\n' "${target_path#/}"
  fi
}

main() {
  if [[ $# -eq 0 ]]; then
    usage
    return 1
  fi

  local -r platform="$1"
  shift

  local dry_run=false
  local section=""
  local -a links=()
  local arg

  for arg in "$@"; do
    case "$arg" in
    --dry-run)
      dry_run=true
      ;;
    --links)
      section="links"
      ;;
    --*)
      dotfiles-log "Unknown argument: $arg"
      return 1
      ;;
    *)
      case "$section" in
      links) links+=("$arg") ;;
      *)
        usage
        return 1
        ;;
      esac
      ;;
    esac
  done

  local mapping source_path target_path
  for mapping in "${links[@]}"; do
    if [[ "$mapping" != *"|"* ]]; then
      dotfiles-log "Invalid link mapping: $mapping"
      return 1
    fi

    source_path="${mapping%%|*}"
    target_path="${mapping#*|}"
    if [[ -z "$source_path" || -z "$target_path" || ! -e "$REPO_DIR/$source_path" ]]; then
      dotfiles-log "Invalid link source: $source_path"
      return 1
    fi
  done

  export DOTFILES_BACKUP_DIR="${DOTFILES_BACKUP_DIR:-$HOME/dotfiles-wayback/$(date +%Y%m%d-%H%M%S)-$$}"

  dotfiles-log "Installing dotfiles for $platform"
  dotfiles-log "Backup directory: $DOTFILES_BACKUP_DIR"
  [[ "$dry_run" == true ]] && dotfiles-log "Dry run: no changes will be made"

  local has_errors=false
  local backup_name expected_source current_source

  for mapping in "${links[@]}"; do
    source_path="${mapping%%|*}"
    target_path="${mapping#*|}"
    expected_source="$REPO_DIR/$source_path"

    if [[ -L "$target_path" ]]; then
      current_source="$(readlink "$target_path")"
      if [[ "$current_source" == "$expected_source" ]]; then
        dotfiles-log "Already installed: $target_path"
        continue
      fi
    fi

    if [[ "$dry_run" == true ]]; then
      [[ -e "$target_path" || -L "$target_path" ]] && dotfiles-log "Would back up: $target_path"
      dotfiles-log "Would link: $target_path -> $expected_source"
      continue
    fi

    if [[ -e "$target_path" || -L "$target_path" ]]; then
      backup_name="$(backup_name_for "$target_path")"
      if ! dotfiles-create-backup "$target_path" "$backup_name"; then
        has_errors=true
        continue
      fi
    fi

    if ! mkdir -p "$(dirname "$target_path")"; then
      dotfiles-log "Failed to create parent directory: $(dirname "$target_path")"
      has_errors=true
      continue
    fi

    if ln -s "$expected_source" "$target_path"; then
      dotfiles-log "Linked: $target_path -> $expected_source"
    else
      dotfiles-log "Failed to link: $target_path"
      has_errors=true
    fi
  done

  if [[ "$has_errors" == true ]]; then
    dotfiles-log "Installation completed with errors"
    return 1
  fi

  dotfiles-log "All dotfiles installed successfully"
}

main "$@"
