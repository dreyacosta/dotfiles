#!/bin/bash

set -u

target_path="$1"
backup_path="$2"
backup_dir="${DOTFILES_BACKUP_DIR:?DOTFILES_BACKUP_DIR must be set}"

if [[ ! -e "$target_path" && ! -L "$target_path" ]]; then
  exit 0
fi

destination="$backup_dir/$backup_path"
if [[ -e "$destination" || -L "$destination" ]]; then
  dotfiles-log "Backup destination already exists: $destination"
  exit 1
fi

dotfiles-log "Backing up: $target_path -> $destination"
mkdir -p "$(dirname "$destination")"
mv "$target_path" "$destination"
