#!/bin/bash

set -euo pipefail

readonly BACKLIGHT_DIR="/sys/class/backlight/appletb_backlight"
readonly DRIVER_DIR="/sys/bus/hid/drivers/hid-appletb-bl"
readonly AUTODIM_PATH="/sys/module/hid_appletb_kbd/parameters/autodim"

readonly ACTION="${1:-}"
[[ "$ACTION" == "start" || "$ACTION" == "pre" || "$ACTION" == "post" ]] || exit 0

system_vendor=""
product_name=""
[[ -r /sys/class/dmi/id/sys_vendor ]] && read -r system_vendor </sys/class/dmi/id/sys_vendor
[[ -r /sys/class/dmi/id/product_name ]] && read -r product_name </sys/class/dmi/id/product_name
[[ "$system_vendor" == "Apple Inc." && "$product_name" == MacBookPro* ]] || exit 0

has_touchbar=false
for usb_device in /sys/bus/usb/devices/*; do
  if [[ -r "$usb_device/idVendor" && -r "$usb_device/idProduct" ]] &&
    [[ "$(<"$usb_device/idVendor")" == "05ac" && "$(<"$usb_device/idProduct")" == "8102" ]]; then
    has_touchbar=true
    break
  fi
done
[[ "$has_touchbar" == true ]] || exit 0

if [[ "$ACTION" == "pre" ]]; then
  if [[ -w "$BACKLIGHT_DIR/brightness" ]]; then
    printf '0' >"$BACKLIGHT_DIR/brightness" || true
  fi

  if [[ -d /sys/module/hid_appletb_kbd ]] && ! modprobe -r hid_appletb_kbd; then
    logger -t touchbar-backlight "Failed to unload Touch Bar keyboard module before suspend"
    exit 0
  fi

  if [[ -d /sys/module/hid_appletb_bl ]] && ! modprobe -r hid_appletb_bl; then
    logger -t touchbar-backlight "Failed to unload Touch Bar backlight module before suspend"
    exit 0
  fi

  logger -t touchbar-backlight "Unloaded Touch Bar HID modules before suspend"
  exit 0
fi

if [[ "$ACTION" == "post" ]] &&
  { ! modprobe hid_appletb_bl || ! modprobe hid_appletb_kbd; }; then
  logger -t touchbar-backlight "Failed to reload Touch Bar HID modules after resume"
  exit 0
fi

for _ in {1..50}; do
  if [[ -e "$AUTODIM_PATH" && -L "$BACKLIGHT_DIR/device" ]]; then
    device_path="$(readlink -f "$BACKLIGHT_DIR/device")"
    device_id="${device_path##*/}"

    if [[ -e "$DRIVER_DIR/$device_id" ]]; then
      if ! printf 'N' >"$AUTODIM_PATH"; then
        logger -t touchbar-backlight "Failed to disable Touch Bar automatic brightness"
        exit 0
      fi

      if ! printf '0' >"$BACKLIGHT_DIR/brightness"; then
        logger -t touchbar-backlight "Failed to turn off Touch Bar backlight"
        exit 0
      fi

      logger -t touchbar-backlight "Requested Touch Bar backlight off after $ACTION: $device_id"
      exit 0
    fi
  fi

  sleep 0.1
done

logger -t touchbar-backlight "Touch Bar backlight device was not available after $ACTION"
